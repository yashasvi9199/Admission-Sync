# ============================================================
# AeroPunchin Environment Variables Configuration
# Rename this file to '.env' and fill in your details.
# ============================================================

# 1. Location Services (LocationIQ)
# Get a free token at https://locationiq.com/
VITE_LOCATIONIQ_TOKEN="your_location_iq_token_here"

# 2. Turso Database (SQLite on libSQL)
# Get your database URL and token by running:
#   turso db show <db-name>
#   turso db tokens create <db-name>
VITE_TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
VITE_TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 3. Google Gemini API (For AI Features - Optional)
# Configure this in Google AI Studio or local variables
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
